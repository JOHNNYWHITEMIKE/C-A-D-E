# API Keys (Optional - for AI integrations)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database – PostgreSQL connection string (asyncpg driver)
# For local dev: start postgres with docker-compose up db
DATABASE_URL=postgresql+asyncpg://cade:cade@localhost:5432/cade

# Path to agents/agents.yaml (absolute or relative to working dir)
# Override when running in Docker: /agents/agents.yaml
AGENTS_MANIFEST_PATH=../agents/agents.yaml
